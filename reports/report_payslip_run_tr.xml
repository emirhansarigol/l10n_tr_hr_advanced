                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-right">Sair Ödemeler Toplamı :</td><td class="text-right"><span t-esc="tot_alw" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="fw-bold text-right">Ödenecek Gelir Vergisi :</td><td class="text-right"><span t-esc="tot_btnet" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-right">İşveren SGK Hissesi :</td><td class="text-right"><span t-esc="isveren_sgk" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="fw-bold text-right">Ödenecek Damga Vergisi :</td><td class="text-right"><span t-esc="tot_stax" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-right">İşveren İşsizlik Sig. Kesintisi :</td><td class="text-right"><span t-esc="isveren_issizlik" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="fw-bold text-right">Ödenecek İşsizlik Sig. Kesintisi :</td><td class="text-right"><span t-esc="odenecek_issizlik" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="2"></td>
                                        <td class="fw-bold text-right">Sair Kesintiler :</td><td class="text-right"><span t-esc="tot_sair_kes" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-right bg-gray">TOPLAM :</td><td class="text-right bg-gray fw-bold"><span t-esc="genel_tahakkuk_sol" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="fw-bold text-right bg-gray">TOPLAM :</td><td class="text-right bg-gray fw-bold"><span t-esc="genel_tahakkuk_sag" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-right">Toplam SGK Primi :</td><td class="text-right"><span t-esc="(odenecek_sgk or 0.0) + (odenecek_issizlik or 0.0)" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="fw-bold text-right">İndirilecek Gelir Vergisi :</td><td class="text-right"><span t-esc="tot_gv_ist" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-right">İndirilecek SGK İşveren Payı :</td><td class="text-right"><span t-esc="ind_sgk_isveren" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="fw-bold text-right">İndirilecek Damga Vergisi :</td><td class="text-right"><span t-esc="tot_dv_ist" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-right">Net Ödenecek SGK Primi :</td><td class="text-right"><span t-esc="((odenecek_sgk or 0.0) + (odenecek_issizlik or 0.0)) - (ind_sgk_isveren or 0.0)" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </template>

